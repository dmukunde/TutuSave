NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The local-part of the Gmail address n8n already polls for
# bank alerts — no "@gmail.com", no "+token". Used to compute each user's
# private forwarding address (base+<their-token>@gmail.com) on the
# Settings page. Never sent to the client.
IMPORT_EMAIL_BASE=
